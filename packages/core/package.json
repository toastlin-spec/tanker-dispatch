{
  "name": "@tanker/core",
  "version": "0.1.0",
  "private": true,
  "description": "時間軸計算、車趟組成、艙位分配與規則檢查（純函式，前後端共用）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "vitest": "3.2.7"
  }
}

# 複製成 deploy.env 後修改（deploy.env 不會 commit）。給 scripts/deploy-cloudrun.sh 使用。
PROJECT_ID=你的GCP專案ID
REGION=asia-east1
SERVICE=tanker
DB_INSTANCE=tanker-db
# docs/auth.md 建立的 OAuth 用戶端 ID（不是密碼；密碼放在 Secret Manager）
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# 一律允許登入的帳號，逗號分隔
AUTH_BOOTSTRAP_EMAILS=you@gmail.com

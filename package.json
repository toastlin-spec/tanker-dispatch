{
  "name": "tanker-dispatch",
  "private": true,
  "description": "油罐車派車管理系統",
  "workspaces": [
    "packages/core",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @tanker/core && npm run build -w @tanker/api && npm run build -w @tanker/web",
    "test": "npm test -w @tanker/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:reset": "node scripts/dev.mjs --reset-db --no-serve"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}

{
  "name": "@tanker/api",
  "version": "0.1.0",
  "private": true,
  "description": "派車系統後端：NestJS + Prisma + PostgreSQL",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "start:watch": "node --watch dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/client": "6.19.3",
    "@tanker/core": "*",
    "express": "5.3.0",
    "google-auth-library": "^10.9.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "vitest": "^3.2.7"
  }
}
